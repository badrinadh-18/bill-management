rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authenticated users can read
    match /{document=**} {
      allow read: if request.auth != null;
    }
    
    // Write only allowed for admin role
    // Assuming custom claims are used: request.auth.token.role == 'admin'
    // If not using custom claims, this could be checked against a users collection
    match /re_bills/{billId} {
      allow create, update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    // New-account onboarding may create a profile record, but it cannot read,
    // change, or delete account records without administrator authentication.
    // Credentials are deliberately never stored in this collection.
    match /re_admin_accounts/{accountId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'profile', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.profile.email == request.resource.data.email;
      allow read, update, delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /re_meta/{docId} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
